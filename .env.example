ALLOWED_EXTERNAL_URL_HOSTS=
ALLOWED_REVIEWER_EMAILS=
ALLOW_REMOTE_DEV_DATABASE=
ALLOW_RUNTIME_DB_SYNC=
ALLOW_SANDBOX_AUTH=
ALLOW_SHARED_DB_PUSH=
APP_URL=
APPLE_CLIENT_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_TEAM_ID=
BACKEND_URL=
DATABASE_URL=
DIRECT_URL=
ENABLE_PRISMA_STUDIO_PROXY=
FRONTEND_URL=
# AI — Cloudflare Workers AI only
AI_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
# CLOUDFLARE_AUTH_TOKEN=  # accepted alias for the API token
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_AI_STUDY_INSIGHT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_VISION_MODEL=@cf/moondream/moondream3.1-9B-A2B
CLOUDFLARE_INFERENCE_TIMEOUT_MS=300000
CLOUDFLARE_MARKDOWN_TIMEOUT_MS=90000
CLOUDFLARE_VISION_TIMEOUT_MS=90000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INITIALIZE_SYSTEM=
JWT_SECRET=
NODE_ENV=
PRISMA_DB_PUSH=
SESSION_SECRET=
SMTP_FROM=
SMTP_HOST=
SMTP_PASS=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SUPABASE_DATABASE_URL=
VITE_API_BASE_URL=
# Private Supabase Storage for PDF/NOTE materials
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=academic-materials

# Cloudflare AI credentials are server-only. Never expose them through a VITE_ prefixed variable.

# Personalization cloud sync is server-only and remains disabled unless explicitly enabled.
PERSONALIZATION_CLOUD_SYNC_ENABLED=
PERSONALIZATION_WORKER_URL=
PERSONALIZATION_SYNC_SECRET=

# Core Study Engine features are released and enabled by default.
# Explicit false/0/no/off values remain emergency kill switches.
STUDY_EVENTS_ENABLED=true
FOCUS_HUB_ENABLED=true
FOCUS_RESOURCE_HANDOFF_ENABLED=true
GROUP_FOCUS_ENABLED=false
# Generate both Group Focus keyrings locally with:
# node scripts/generate-group-focus-runtime-secrets.mjs
# Group Focus signing keys. The capability keyring is required on Render and
# the Group Focus Worker. A dedicated reconciliation keyring is recommended,
# but optional: when omitted on both sides the runtime safely reuses the shared
# capability keyring with a separate reconciliation signing domain.
GROUP_FOCUS_CAPABILITY_KEYS_JSON=
GROUP_FOCUS_CAPABILITY_ACTIVE_KID=
# Optional dedicated machine-auth keyring. If one of these is configured,
# configure the same values on Render and the Group Focus Worker.
GROUP_FOCUS_RECONCILIATION_KEYS_JSON=
GROUP_FOCUS_RECONCILIATION_ACTIVE_KID=
# GROUP_FOCUS_API_BASE_URL is optional for the production deployment because
# the Worker defaults to https://nine9s-guide.onrender.com. Set it explicitly
# for staging/custom API origins; see cloudflare-group-focus-worker/README.md.
# Deploy only after /ready returns runtimeReady=true.
# Group Focus Worker origin. The backend returns the canonical runtime origin
# with each short-lived capability, so stale frontend builds cannot pin users to
# an old Worker URL. The VITE value remains a browser-side fallback.
GROUP_FOCUS_WORKER_URL=https://99s-guide.mustafasamadlol2.workers.dev
VITE_GROUP_FOCUS_FRONTEND_ENABLED=false
VITE_GROUP_FOCUS_WORKER_URL=https://99s-guide.mustafasamadlol2.workers.dev
STUDY_POINTS_ENABLED=true
# Points V2 competitive cutover. Set once before first deploy and never move it forward.
STUDY_POINTS_V2_EPOCH=2026-10-18T12:32:00.000Z
STUDY_INTEGRITY_ENABLED=true
GAMIFICATION_ENABLED=true
SPACED_RECALL_ENABLED=false
MASTERY_ENABLED=false
STUDY_ANALYZER_ENABLED=false
AI_STUDY_INSIGHTS_ENABLED=false
AI_STUDY_INSIGHTS_CACHE_ENABLED=false
OWNER_STUDY_ANALYTICS_ENABLED=false
LEADERBOARD_D1_PROJECTION_ENABLED=false
LEADERBOARD_D1_READ_ENABLED=false

# Private D1 Study Engine projection reads remain disabled until product routes opt in.
PRIVATE_D1_FOCUS_PLAN_READS_ENABLED=false
PRIVATE_D1_FOCUS_SESSION_READS_ENABLED=false
PRIVATE_D1_STUDY_DAILY_METRIC_READS_ENABLED=false

# Cloudflare academic-content read replica (Phase 1)
# CONTENT_WORKER_BASE_URL=https://99s-content-api.<your-workers-subdomain>.workers.dev
# CONTENT_SYNC_SECRET=replace-with-a-long-random-secret
# Keep false until `npm run content:d1:backfill` reports a clean verification.
CONTENT_D1_PHASE1_CUTOVER_ENABLED=false
# Optional pre-cutover route-by-route switches; the Phase 1 cutover flag enables all of them.
CONTENT_D1_READS_ENABLED=false
CONTENT_D1_MATERIALS_READS_ENABLED=false
CONTENT_D1_MODULE_RESOURCES_READS_ENABLED=false
CONTENT_D1_SEARCH_READS_ENABLED=false
CONTENT_D1_CALENDAR_READS_ENABLED=false
CONTENT_D1_MOTTO_READS_ENABLED=false
CONTENT_D1_FLASHCARD_READS_ENABLED=false

# Phase 3 — user/auth read replica (Supabase remains canonical)
PRIVATE_DATA_WORKER_BASE_URL=
PRIVATE_DATA_SYNC_SECRET=
PRIVATE_D1_WRITE_MIRROR_ENABLED=false
PRIVATE_D1_SYNC_POLL_MS=5000
PRIVATE_D1_PHASE3_CUTOVER_ENABLED=false
