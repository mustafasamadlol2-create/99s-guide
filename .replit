modules = ["web", "swift-5.8", "nodejs-22", "python-base-3.13", "postgresql-16"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 DIRECT_URL=\"$DATABASE_URL\" JWT_SECRET=\"$SESSION_SECRET\" PRISMA_DB_PUSH=true npm run dev"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5173
externalPort = 5173

[[ports]]
localPort = 9229
externalPort = 80
exposeLocalhost = true

[[ports]]
localPort = 9230
externalPort = 3000
exposeLocalhost = true

[userenv]

[userenv.shared]
VITE_API_BASE_URL = "https://nine9s-guide.onrender.com"
