{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "99sguide-group-focus",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "workers_dev": false,
  "observability": {
    "enabled": false
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GROUP_FOCUS_ROOMS",
        "class_name": "GroupFocusRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GroupFocusRoom"]
    }
  ]
}