{
  "name": "med99guide",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/predev.cjs",
    "build:frontend": "node scripts/build-frontend.cjs",
    "postinstall": "npx prisma generate",
    "dev": "node scripts/run-dev.cjs",
    "build": "npm run build:frontend && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "start": "node scripts/start-production.cjs",
    "preview": "npm run build && wrangler dev",
    "clean": "node scripts/clean.cjs",
    "test:auth": "tsx --test tests/oauth-state.test.ts",
    "test:study-engine": "tsx --test --test-concurrency=1 tests/focus-*.test.ts tests/group-focus-*.test.ts tests/study-*.test.ts tests/recall-*.test.ts tests/gamification-*.test.ts tests/leaderboard-*.test.ts tests/mastery-*.test.ts tests/lecture-mastery-*.test.ts tests/lecture-retention-*.test.ts tests/owner-analytics*.test.ts tests/ask-study-data-*.test.ts tests/private-d1-*.test.ts tests/prompt11-focus-client.test.ts",
    "test:study-observability": "tsx --test --test-concurrency=1 tests/observability.test.ts tests/release-gates.test.ts tests/release-rollout-guard.test.ts",
    "test:owner-analytics-frontend": "tsx --test tests/owner-analytics-frontend-api.test.ts",
    "test:gamification": "tsx --test tests/gamification-definitions.test.ts tests/gamification-metrics.test.ts tests/gamification-migration.test.ts tests/gamification-ruleset-postgres.test.ts",
    "test:gamification-achievements": "tsx --test tests/gamification-achievements.test.ts tests/gamification-achievements-postgres.test.ts",
    "test:group-focus": "tsx --test tests/group-focus-contracts.test.ts tests/group-focus-capability.test.ts tests/group-focus-postgres.test.ts",
    "test:group-focus-capability": "tsx --test tests/group-focus-capability.test.ts tests/group-focus-capability-postgres.test.ts",
    "test:group-focus-prompt15": "tsx --test tests/group-focus-realtime-protocol.test.ts tests/group-focus-room-state.test.ts tests/group-focus-realtime-client.test.ts tests/group-focus-durable-object.test.ts",
    "worker:group-focus:typecheck": "wrangler types cloudflare-group-focus-worker/worker-configuration.d.ts --config cloudflare-group-focus-worker/wrangler.jsonc --check && tsc --project cloudflare-group-focus-worker/tsconfig.json",
    "worker:group-focus:dry-run": "wrangler deploy --config cloudflare-group-focus-worker/wrangler.jsonc --dry-run --outdir /tmp/99sguide-group-focus-worker-dry-run",
    "test:postgres": "tsx --test tests/private-d1-outbox-schema.test.ts tests/outbox-lifecycle-migration.test.ts && tsx --test tests/private-d1-outbox-postgres.test.ts && tsx --test tests/study-event-postgres-integration.test.ts",
    "test:recall": "tsx --test tests/recall-candidate.test.ts tests/recall-eligibility.test.ts tests/recall-private-routes.test.ts tests/recall-contracts.test.ts tests/recall-policy-cooldown.test.ts tests/recall-interaction-token.test.ts tests/recall-postgres.test.ts tests/recall-candidate-postgres.test.ts tests/recall-prompt30-postgres.test.ts",
    "test:leaderboard": "tsx --test tests/leaderboard.test.ts tests/leaderboard-postgres.test.ts",
    "test:ai": "tsx --test tests/ai-foundation.test.ts",
    "test:ai-input": "tsx --test tests/ai-input.test.ts && tsc --noEmit --target ES2022 --module ESNext --moduleResolution bundler --skipLibCheck --allowSyntheticDefaultImports server/services/ai/input/*.ts tests/ai-input-contracts.type-test.ts",
    "test:ai-media": "tsx --test tests/ai-gemini-media.test.ts",
    "test:ai-mcq": "tsx --test tests/ai-mcq-engine.test.ts",
    "test:ai-flashcard": "tsx --test tests/ai-flashcard-engine.test.ts",
    "lint": "eslint . --ignore-pattern '.local/**'",
    "typecheck": "tsc --noEmit",
    "security:check": "node scripts/security-contracts.cjs",
    "backfill:mcq-metadata": "tsx scripts/backfill-mcq-metadata.ts",
    "study-maintenance": "tsx server/study-maintenance/cli/main.ts",
    "study:release-check": "tsx scripts/study-release-check.ts",
    "study:rollout-status": "tsx scripts/study-rollout-status.ts",
    "study:diagnose": "tsx scripts/study-diagnose.ts",
    "test:study-maintenance": "tsx --test --test-concurrency=1 tests/study-maintenance-*.test.ts",
    "study:rebuild:points": "tsx server/study-maintenance/cli/main.ts points rebuild",
    "study:rebuild:mastery": "tsx server/study-maintenance/cli/main.ts mastery rebuild",
    "study:rebuild:retention": "tsx server/study-maintenance/cli/main.ts retention rebuild",
    "study:replay:outbox": "tsx server/study-maintenance/cli/main.ts outbox replay",
    "study:rebuild:d1": "tsx server/study-maintenance/cli/main.ts private-d1 rebuild",
    "study:compact": "tsx server/study-maintenance/cli/main.ts outbox compact",
    "study:readiness": "tsx server/study-maintenance/cli/main.ts readiness preflight",
    "cap:sync": "node scripts/validate-capacitor-env.cjs && npm run build && npx cap sync",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "deploy": "npm run build && wrangler deploy",
    "migrate:deploy": "prisma migrate deploy",
    "start:server": "node dist/server.cjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@google/genai": "^2.23.0",
    "@napi-rs/canvas": "^1.0.9",
    "@prisma/client": "^5.22.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/compression": "^1.8.1",
    "@vitejs/plugin-react": "^5.2.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dayjs": "^1.11.21",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.1",
    "fuzzysort": "^3.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.468.0",
    "motion": "^12.42.2",
    "multer": "^2.4.0",
    "nodemailer": "^9.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "xss-clean": "^0.1.4",
    "zod": "^4.6.5"
  },
  "overrides": {
    "tar": "^7.5.17"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.3",
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.25.12",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "nodemon": "^3.1.14",
    "prisma": "^5.22.0",
    "tsx": "^4.23.1",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.4.3",
    "wrangler": "^4.128.0"
  }
}
