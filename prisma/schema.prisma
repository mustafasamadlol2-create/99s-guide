generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum LectureMasteryState {
  NOT_STARTED
  STARTED
  LEARNING
  NEEDS_REVIEW
  GOOD
  MASTERED
}

model User {
  id                             String                         @id @default(uuid())
  email                          String                         @unique
  profileEmail                   String?
  passwordHash                   String?
  name                           String?
  avatar                         String?                        @default("")
  avatarUrl                      String?                        @default("")
  signature                      String?                        @default("")
  role                           String                         @default("user")
  isOnline                       Boolean                        @default(false)
  lastActive                     DateTime                       @default(now())
  lastSeen                       DateTime                       @default(now())
  socketId                       String?
  deviceToken                    String?
  accountStatus                  String                         @default("ACTIVE")
  isPrimaryOwner                 Boolean                        @default(false)
  emailVerified                  Boolean                        @default(true)
  sessionVersion                 Int                            @default(0)
  createdAt                      DateTime                       @default(now())
  updatedAt                      DateTime                       @updatedAt
  studentGroup                   String                         @default("A")
  totalPoints                    Int                            @default(0)
  level                          String                         @default("Rising (Resident)")
  levelBadge                     String                         @default("👶")
  streakDays                     Int                            @default(0)
  totalTimeSpent                 Int                            @default(0)
  preferences                    Json?                          @default("{\"theme\": \"system\", \"language\": \"en\", \"pushAlerts\": true}")
  calendarEvents                 CalendarEvent[]
  flashcardProgresses            FlashcardProgress[]
  lectureProgresses              LectureProgress[]
  pointsLogs                     PointsLog[]
  userProgresses                 UserProgress[]
  qaQuestions                    QaQuestion[]                   @relation("QaQuestions")
  qaAnswers                      QaAnswer[]                     @relation("QaAnswers")
  blocksMade                     UserBlock[]                    @relation("BlocksMade")
  blocksReceived                 UserBlock[]                    @relation("BlocksReceived")
  reportsMade                    Report[]                       @relation("ReportsMade")
  reportsReceived                Report[]                       @relation("ReportsReceived")
  mutesReceived                  UserMute[]                     @relation("MutesReceived")
  bansReceived                   UserBan[]                      @relation("BansReceived")
  moderationActionsGiven         ModerationHistory[]            @relation("HistoryByAdmin")
  moderationActionsReceived      ModerationHistory[]            @relation("HistoryForTarget")
  passwordResetTokens            PasswordResetToken[]
  emailVerificationTokens        EmailVerificationToken[]
  oauthIdentities                OAuthIdentity[]                @relation
  qaVotes                        QaVote[]
  calendarImportJobs             CalendarImportJob[]
  resourceMultipartUploads       ResourceMultipartUpload[]
  focusPlans                     FocusPlan[]
  focusSessions                  FocusSession[]
  focusQuickNotes                FocusQuickNote[]
  studyEvents                    StudyEvent[]
  studyDailyMetrics              StudyDailyMetric[]
  recallAttempts                 RecallAttempt[]
  recallItemStates               RecallItemState[]
  lectureMastery                  LectureMastery[]
  groupFocusRoomsHosted          GroupFocusRoom[]               @relation("GroupFocusRoomHost")
  groupFocusMemberships          GroupFocusMembership[]
  groupFocusParticipantSummaries GroupFocusParticipantSummary[]
  integritySignals               IntegritySignal[]              @relation("IntegritySignalSubject")
  integrityReviewActions         IntegrityReviewAction[]        @relation("IntegrityReviewReviewer")

  studyPointsLedgerEntries     StudyPointsLedgerEntry[]
  studyPointsBalanceProjection StudyPointsBalanceProjection?
  userAchievementProgresses    UserAchievementProgress[]
  achievements                 UserAchievement[]
  gamificationLevel            UserGamificationLevel?
  challengeProgresses          UserChallengeProgress[]
  leaderboardSnapshotEntries   LeaderboardSnapshotEntry[]

  @@index([role])
  @@index([isOnline, lastActive])
  @@index([studentGroup])
  @@index([name])
  @@index([createdAt])
  @@index([accountStatus])
  @@index([isPrimaryOwner])
}

model Lecture {
  id                             String                         @id @default(uuid())
  name                           String
  mainSubject                    String
  subSubject                     String?
  trackMode                      String
  department                     String?
  createdAt                      DateTime                       @default(now())
  flashcards                     Flashcard[]
  lectureProgresses              LectureProgress[]
  materials                      Material[]
  mcqs                           Mcq[]
  resourceMultipartUploads       ResourceMultipartUpload[]
  focusPlanItems                 FocusPlanItem[]
  focusSessions                  FocusSession[]
  focusQuickNotes                FocusQuickNote[]               @relation("FocusQuickNoteLecture")
  studyEvents                    StudyEvent[]
  masteryProjections             LectureMastery[]
  groupFocusRoomsShared          GroupFocusRoom[]               @relation("GroupFocusRoomSharedLecture")
  groupFocusMemberships          GroupFocusMembership[]         @relation("GroupFocusMembershipSelectedLecture")
  groupFocusParticipantSummaries GroupFocusParticipantSummary[] @relation("GroupFocusSummaryLecture")

  @@index([name])
  @@index([mainSubject])
}

model Material {
  id             String         @id @default(uuid())
  title          String
  type           String
  fileUrlOrLink  String
  lectureId      String
  createdAt      DateTime       @default(now())
  fileData       Bytes?
  storagePath    String?
  lecture        Lecture        @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  userProgresses UserProgress[]
  studyEvents    StudyEvent[]

  @@index([lectureId])
  @@index([title])
  @@index([storagePath])
}

model ResourceMultipartUpload {
  id                String   @id @default(uuid())
  userId            String
  lectureId         String
  title             String
  originalFilename  String
  sanitizedFilename String
  mimeType          String
  declaredSizeBytes BigInt
  lastModifiedMs    BigInt?
  storagePath       String   @unique
  multipartUploadId String
  partSizeBytes     Int
  expectedPartCount Int
  status            String   @default("UPLOADING")
  createdAt         DateTime @default(now())
  expiresAt         DateTime
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lecture           Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  @@index([userId, status, expiresAt])
  @@index([lectureId, status])
}

model ModuleResource {
  id                String    @id @default(uuid())
  moduleId          String
  title             String
  storagePath       String    @unique
  fileSizeBytes     BigInt
  status            String    @default("PENDING")
  multipartUploadId String?
  uploadExpiresAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([moduleId, status, createdAt])
  @@index([status, uploadExpiresAt])
}

model Mcq {
  id            String       @id @default(uuid())
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  hint          String?
  explanation   String?
  sourceType    String       @default("ai")
  sourceRef     String       @default("")
  difficulty    String       @default("Medium")
  lectureId     String
  createdAt     DateTime     @default(now())
  lecture       Lecture      @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  studyEvents   StudyEvent[]

  @@index([lectureId])
  @@index([question])
}

model Flashcard {
  id                  String              @id @default(uuid())
  clinicalConcept     String
  explanation         String
  lectureId           String
  createdAt           DateTime            @default(now())
  lecture             Lecture             @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  flashcardProgresses FlashcardProgress[]
  studyEvents         StudyEvent[]

  @@index([lectureId])
  @@index([clinicalConcept])
}

model CalendarEvent {
  id                   String   @id @default(uuid())
  userId               String?
  title                String
  eventType            String
  startDateTime        DateTime
  endDateTime          DateTime
  targetGroups         String   @default("ALL")
  description          String?
  subjectId            String?
  lectureId            String?
  room                 String?
  doctor               String?
  notes                String?
  isPinned             Boolean  @default(false)
  isCompleted          Boolean  @default(false)
  allDay               Boolean  @default(false)
  importSource         String?
  sourceDocumentName   String?
  sourceDocumentSha256 String?
  sourcePage           Int?
  importFingerprint    String?  @unique
  user                 User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([startDateTime])
  @@index([endDateTime])
  @@index([userId])
  @@index([eventType])
  @@index([targetGroups])
  @@index([sourceDocumentSha256])
}

model CalendarImportJob {
  id                  String    @id @default(uuid())
  userId              String
  status              String    @default("UPLOADED")
  stage               String    @default("Uploading")
  sourceFileName      String
  sourceMime          String
  sourceSha256        String
  sourcePageCount     Int?
  sourcePath          String?
  timezone            String    @default("Asia/Baghdad")
  defaultTargetGroups String    @default("ALL")
  progressCurrent     Int       @default(0)
  progressTotal       Int       @default(0)
  previewData         Json?
  errorCode           String?
  errorMessage        String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  completedAt         DateTime?
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([status, updatedAt])
  @@index([sourceSha256])
}

model PointsLog {
  id        String   @id @default(uuid())
  userId    String
  points    Int
  reason    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model SmartNotification {
  id     String   @id @default(uuid())
  title  String
  body   String
  type   String   @default("system")
  sentAt DateTime @default(now())
  read   Boolean  @default(false)

  @@index([read, sentAt])
  @@index([type])
}

model LectureProgress {
  userId              String
  lectureId           String
  pdfCompleted        Boolean  @default(false)
  notesCompleted      Boolean  @default(false)
  videoCompleted      Boolean  @default(false)
  flashcardsCompleted Boolean  @default(false)
  quizCompleted       Boolean  @default(false)
  quizScore           Int?
  lastAccessed        DateTime @default(now())
  lecture             Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, lectureId])
  @@index([lectureId])
}

model UserProgress {
  id          String   @id @default(uuid())
  userId      String
  materialId  String
  hasViewed   Boolean  @default(false)
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  material    Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
  @@index([materialId])
}

model Notification {
  id           String   @id @default(uuid())
  title        String
  message      String
  isSystem     Boolean  @default(true)
  targetUserId String?
  targetGroup  String? // null = everyone; "A"/"B"/"C"/"D"/"E" = that group only
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([targetUserId])
  @@index([targetGroup])
}

model FlashcardProgress {
  id          String    @id @default(uuid())
  userId      String
  flashcardId String
  status      String    @default("medium")
  updatedAt   DateTime  @updatedAt
  flashcard   Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, flashcardId])
  @@index([userId])
}

model DailyMotto {
  id         String   @id @default(uuid())
  message    String
  isActive   Boolean  @default(true)
  isFeatured Boolean  @default(false)
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive])
  @@index([createdAt])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime
}

model QaQuestion {
  id        String     @id @default(uuid())
  lectureId String
  userId    String
  content   String
  upvotes   Int        @default(0)
  isDeleted Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation("QaQuestions", fields: [userId], references: [id], onDelete: Cascade)
  answers   QaAnswer[]

  @@index([lectureId])
  @@index([userId])
}

model QaAnswer {
  id         String     @id @default(uuid())
  questionId String
  userId     String
  content    String
  upvotes    Int        @default(0)
  isBest     Boolean    @default(false)
  isDeleted  Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User       @relation("QaAnswers", fields: [userId], references: [id], onDelete: Cascade)
  question   QaQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([userId])
}

model QaVote {
  id         String   @id @default(uuid())
  userId     String
  targetId   String
  targetType String
  value      Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
}

model UserMute {
  id          String    @id @default(uuid())
  userId      String    @unique
  reason      String
  startTime   DateTime  @default(now())
  endTime     DateTime?
  isPermanent Boolean   @default(false)
  createdBy   String
  createdAt   DateTime  @default(now())
  user        User      @relation("MutesReceived", fields: [userId], references: [id], onDelete: Cascade)

  @@index([endTime])
}

model UserBan {
  id          String    @id @default(uuid())
  userId      String    @unique
  reason      String
  startTime   DateTime  @default(now())
  endTime     DateTime?
  isPermanent Boolean   @default(false)
  createdBy   String
  createdAt   DateTime  @default(now())
  user        User      @relation("BansReceived", fields: [userId], references: [id], onDelete: Cascade)

  @@index([endTime])
}

model Report {
  id             String   @id @default(uuid())
  reporterId     String
  reportedUserId String
  lectureId      String?
  commentId      String
  commentType    String
  commentContent String
  reason         String
  description    String?
  status         String   @default("Pending")
  createdAt      DateTime @default(now())
  reporter       User     @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser   User     @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@unique([reporterId, commentId])
  @@index([reporterId])
  @@index([reportedUserId])
  @@index([commentId])
  @@index([status])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model OAuthIdentity {
  id              String   @id @default(uuid())
  userId          String   @unique
  provider        String
  providerSubject String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([provider])
  @@index([providerSubject])
}

model ModerationHistory {
  id             String    @id @default(cuid())
  actionType     String
  adminId        String?
  targetUserId   String?
  commentId      String?
  questionId     String?
  answerId       String?
  replyId        String?
  lectureId      String?
  reportId       String?
  reason         String?
  notes          String?
  oldStatus      String?
  newStatus      String?
  duration       Int?
  isPermanent    Boolean   @default(false)
  isSystemAction Boolean   @default(false)
  createdAt      DateTime  @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?
  revokedBy      String?
  metadata       Json?

  admin      User? @relation("HistoryByAdmin", fields: [adminId], references: [id])
  targetUser User? @relation("HistoryForTarget", fields: [targetUserId], references: [id])

  @@index([adminId])
  @@index([targetUserId])
  @@index([actionType])
  @@index([createdAt])
  @@index([reportId])
  @@index([lectureId])
  @@index([questionId])
  @@index([answerId])
  @@index([isSystemAction])
  @@index([expiresAt])
  @@index([revokedAt])
}

/// Private student-owned Focus Hub plan. Status remains an application-level
/// string until the Focus Service freezes its lifecycle semantics.
model FocusPlan {
  id          String    @id @default(uuid())
  userId      String
  title       String
  status      String    @default("ACTIVE")
  timezone    String
  planVersion Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         FocusPlanItem[]
  focusSessions FocusSession[]

  @@index([userId, status, updatedAt])
}

/// Each Lecture has independent Focus configuration inside a plan.
model FocusPlanItem {
  id                   String   @id @default(uuid())
  planId               String
  lectureId            String
  sequence             Int
  sessionCount         Int
  focusDurationSeconds Int
  breakDurationSeconds Int
  includeMcq           Boolean
  includeFlashcards    Boolean
  includeVideo         Boolean
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  plan                FocusPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  lecture             Lecture         @relation(fields: [lectureId], references: [id], onDelete: Restrict)
  focusSessions       FocusSession[]
  quickNoteConversion FocusQuickNote? @relation("FocusQuickNoteConversion")

  @@unique([planId, sequence])
}

/// Durable solo Focus lifecycle/checkpoint record. Restricting plan/content
/// deletion protects historical sessions; archival is preferred.
model FocusSession {
  id               String    @id @default(uuid())
  userId           String
  planId           String
  planItemId       String
  lectureId        String
  status           String    @default("CREATED")
  startedAt        DateTime?
  plannedEndAt     DateTime?
  actualEndedAt    DateTime?
  lastCheckpointAt DateTime?
  activeSeconds    Int       @default(0)
  pauseSeconds     Int       @default(0)
  completionReason String?
  clientInstanceId String?
  idempotencyKey   String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        FocusPlan        @relation(fields: [planId], references: [id], onDelete: Restrict)
  planItem    FocusPlanItem    @relation(fields: [planItemId], references: [id], onDelete: Restrict)
  lecture     Lecture          @relation(fields: [lectureId], references: [id], onDelete: Restrict)
  quickNotes  FocusQuickNote[] @relation("FocusQuickNoteSession")
  studyEvents StudyEvent[]

  @@unique([userId, idempotencyKey])
  @@index([userId, status, updatedAt])
  @@index([userId, startedAt])
  @@index([planId, planItemId])
}

/// Private, PostgreSQL-only notes attached to a canonical solo Focus Session.
model FocusQuickNote {
  id                    String    @id @default(uuid())
  userId                String
  focusSessionId        String
  lectureId             String
  content               String
  status                String    @default("ACTIVE")
  idempotencyKey        String
  convertedToPlanItemId String?   @unique
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  archivedAt            DateTime?
  convertedAt           DateTime?

  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  focusSession        FocusSession   @relation("FocusQuickNoteSession", fields: [focusSessionId], references: [id], onDelete: Restrict)
  lecture             Lecture        @relation("FocusQuickNoteLecture", fields: [lectureId], references: [id], onDelete: Restrict)
  convertedToPlanItem FocusPlanItem? @relation("FocusQuickNoteConversion", fields: [convertedToPlanItemId], references: [id], onDelete: Restrict)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([focusSessionId, createdAt])
  @@index([lectureId, createdAt])
}

model GroupFocusRoom {
  id                   String    @id @default(uuid())
  hostUserId           String
  name                 String
  visibility           String
  mode                 String
  sharedLectureId      String?
  focusDurationSeconds Int
  breakDurationSeconds Int
  roundCount           Int
  maxParticipants      Int       @default(12)
  status               String    @default("OPEN")
  createIdempotencyKey String
  inviteTokenHash      String?
  inviteVersion        Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  closedAt             DateTime?

  host          User                   @relation("GroupFocusRoomHost", fields: [hostUserId], references: [id], onDelete: Cascade)
  sharedLecture Lecture?               @relation("GroupFocusRoomSharedLecture", fields: [sharedLectureId], references: [id], onDelete: Restrict)
  memberships   GroupFocusMembership[]
  run           GroupFocusRun?

  @@unique([hostUserId, createIdempotencyKey])
  @@index([visibility, status, createdAt])
  @@index([hostUserId, status])
  @@index([sharedLectureId])
}

model GroupFocusMembership {
  id                String    @id @default(uuid())
  roomId            String
  userId            String
  role              String
  status            String    @default("ACTIVE")
  selectedLectureId String?
  joinedAt          DateTime  @default(now())
  leftAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  room               GroupFocusRoom                @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user               User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  selectedLecture    Lecture?                      @relation("GroupFocusMembershipSelectedLecture", fields: [selectedLectureId], references: [id], onDelete: Restrict)
  participantSummary GroupFocusParticipantSummary?

  @@unique([roomId, userId])
  @@index([roomId, status])
  @@index([userId, status])
  @@index([selectedLectureId])
}

/// Canonical immutable result of one terminal Durable Object runtime.
model GroupFocusRun {
  id                   String   @id @default(uuid())
  roomId               String   @unique
  summaryId            String   @unique
  runtimeInstanceId    String   @unique
  summaryVersion       Int
  summaryHash          String   @db.Char(64)
  mode                 String
  focusDurationSeconds Int
  breakDurationSeconds Int
  roundCount           Int
  runtimeStartedAt     DateTime
  runtimeEndedAt       DateTime
  terminalReason       String
  completedRounds      Int
  finalRevision        Int
  createdAt            DateTime @default(now())

  room         GroupFocusRoom                 @relation(fields: [roomId], references: [id], onDelete: Restrict)
  participants GroupFocusParticipantSummary[]

  @@index([runtimeEndedAt])
}

/// One verified, private participation aggregate per canonical member and run.
model GroupFocusParticipantSummary {
  id                   String    @id @default(uuid())
  runId                String
  userId               String
  membershipId         String    @unique
  role                 String
  effectiveLectureId   String
  firstConnectedAt     DateTime
  lastDisconnectedAt   DateTime?
  reconnectCount       Int
  verifiedFocusSeconds Int
  rounds               Json
  createdAt            DateTime  @default(now())

  run              GroupFocusRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership       GroupFocusMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  effectiveLecture Lecture              @relation("GroupFocusSummaryLecture", fields: [effectiveLectureId], references: [id], onDelete: Restrict)

  @@unique([runId, userId])
  @@index([userId, createdAt])
  @@index([effectiveLectureId, createdAt])
}

/// Canonical normalized learning-event envelope. Event values remain strings
/// so future valid event types do not require a database enum migration.
model StudyEvent {
  id               String   @id @default(uuid())
  schemaVersion    Int      @default(1)
  eventType        String
  userId           String
  occurredAt       DateTime
  receivedAt       DateTime
  source           String
  idempotencyKey   String
  lectureId        String?
  materialId       String?
  mcqId            String?
  flashcardId      String?
  focusSessionId   String?
  groupFocusRoomId String?
  evidenceClass    String
  privacyClass     String
  payload          Json
  createdAt        DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lecture      Lecture?      @relation(fields: [lectureId], references: [id], onDelete: SetNull)
  material     Material?     @relation(fields: [materialId], references: [id], onDelete: SetNull)
  mcq          Mcq?          @relation(fields: [mcqId], references: [id], onDelete: SetNull)
  flashcard    Flashcard?    @relation(fields: [flashcardId], references: [id], onDelete: SetNull)
  focusSession FocusSession? @relation(fields: [focusSessionId], references: [id], onDelete: SetNull)

  @@unique([userId, idempotencyKey])
  @@index([userId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([lectureId, occurredAt])
  @@index([focusSessionId, occurredAt])
}

/// Server-derived private daily counters. metricDate is a PostgreSQL DATE
/// representing the logical academic day, calculated by the service.
model StudyDailyMetric {
  id                 String   @id @default(uuid())
  userId             String
  metricDate         DateTime @db.Date
  focusSeconds       Int      @default(0)
  sessionsCompleted  Int      @default(0)
  mcqAttempts        Int      @default(0)
  mcqCorrect         Int      @default(0)
  flashcardReviews   Int      @default(0)
  recallAttempts     Int      @default(0)
  recallCorrect      Int      @default(0)
  lectureCompletions Int      @default(0)
  interruptionCount  Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, metricDate])
}

/// Private, deduplicated technical observations that may need owner/admin review.
model IntegritySignal {
  id                String    @id @default(uuid())
  userId            String
  actionType        String    @db.VarChar(96)
  observationCode   String    @db.VarChar(96)
  category          String    @db.VarChar(32)
  severity          String    @db.VarChar(16)
  ruleId            String    @db.VarChar(128)
  ruleVersion       String    @db.VarChar(128)
  evidenceClass     String    @db.VarChar(48)
  source            String    @db.VarChar(32)
  privacyClass      String    @default("ADMIN_SECURITY") @db.VarChar(32)
  signalFingerprint String    @db.Char(64)
  dedupBucket       Int
  generation        Int       @default(0)
  resourceKind      String?   @db.VarChar(48)
  resourceId        String?   @db.VarChar(128)
  firstOccurredAt   DateTime
  lastOccurredAt    DateTime
  lastReceivedAt    DateTime
  occurrenceCount   Int       @default(1)
  status            String    @default("OPEN") @db.VarChar(16)
  reviewVersion     Int       @default(0)
  latestSafeDetails Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  resolvedAt        DateTime?

  user          User                    @relation("IntegritySignalSubject", fields: [userId], references: [id], onDelete: Cascade)
  reviewActions IntegrityReviewAction[]

  @@unique([userId, signalFingerprint, dedupBucket, generation])
  @@index([status, severity, lastOccurredAt])
  @@index([userId, status, lastOccurredAt])
  @@index([actionType, status, lastOccurredAt])
  @@index([category, lastOccurredAt])
  @@index([observationCode, lastOccurredAt])
  @@index([ruleId, lastOccurredAt])
}

/// Append-only review history. Reviewer deletion preserves the audit row.
model IntegrityReviewAction {
  id             String   @id @default(uuid())
  signalId       String
  reviewerUserId String?
  fromStatus     String   @db.VarChar(16)
  toStatus       String   @db.VarChar(16)
  actionType     String   @db.VarChar(16)
  note           String?  @db.VarChar(1000)
  createdAt      DateTime @default(now())

  signal   IntegritySignal @relation(fields: [signalId], references: [id], onDelete: Cascade)
  reviewer User?           @relation("IntegrityReviewReviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull)

  @@index([signalId, createdAt])
  @@index([reviewerUserId, createdAt])
}

/// Infrastructure-only queue for canonical-to-private-D1 projection delivery.
/// The enqueue path assigns revision from the same generated BIGINT as id.
model PrivateD1SyncOutbox {
  id            BigInt   @id @default(autoincrement())
  entity        String   @db.VarChar(100)
  operation     String   @db.VarChar(16)
  key           Json
  revision      BigInt
  data          Json?
  attempts      Int      @default(0)
  lastError     String?  @db.VarChar(500)
  nextAttemptAt DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([nextAttemptAt, id])
}

/// Durable global Leaderboard snapshot projection work. PostgreSQL remains
/// canonical; this queue contains only rebuildable D1 delivery payloads.
model LeaderboardD1SyncOutbox {
  id             BigInt   @id @default(autoincrement())
  workType       String   @db.VarChar(16)
  snapshotId     String
  chunkIndex     Int      @default(-1)
  payload        Json
  attempts       Int      @default(0)
  nextAttemptAt  DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  createdAt      DateTime @default(now())
  lastError      String?  @db.VarChar(500)
  leaseGeneration Int     @default(0)
  leaseUntil     DateTime?

  @@unique([snapshotId, workType, chunkIndex], map: "leaderboard_d1_outbox_snapshot_work_key")
  @@index([nextAttemptAt, id], map: "leaderboard_d1_outbox_next_attempt_idx")
  @@map("LeaderboardD1SyncOutbox")
}

/// Append-only canonical Study Points accounting rows. Corrections use reversals.
model StudyPointsLedgerEntry {
  id                String   @id @default(uuid())
  userId            String
  amount            Int
  category          String   @db.VarChar(16)
  reasonCode        String   @db.VarChar(96)
  sourceType        String   @db.VarChar(32)
  sourceId          String?  @db.VarChar(128)
  ruleVersion       String   @db.VarChar(128)
  idempotencyKey    String   @db.VarChar(200)
  effectiveAt       DateTime
  createdAt         DateTime @default(now())
  reversalOfEntryId String?  @unique
  metadata          Json?

  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  reversalOf StudyPointsLedgerEntry? @relation("StudyPointsReversal", fields: [reversalOfEntryId], references: [id], onDelete: Cascade)
  reversedBy StudyPointsLedgerEntry? @relation("StudyPointsReversal")

  @@unique([userId, idempotencyKey])
  @@index([userId, effectiveAt, id])
  @@index([userId, category, effectiveAt])
  @@index([sourceType, sourceId])
}

/// Rebuildable account read model. The append-only ledger remains canonical.
model StudyPointsBalanceProjection {
  userId            String    @id
  focusPoints       BigInt    @default(0) @db.BigInt
  masteryPoints     BigInt    @default(0) @db.BigInt
  progressPoints    BigInt    @default(0) @db.BigInt
  consistencyPoints BigInt    @default(0) @db.BigInt
  totalPoints       BigInt    @default(0) @db.BigInt
  ledgerEntryCount  BigInt    @default(0) @db.BigInt
  projectionVersion BigInt    @default(0) @db.BigInt
  lastReconciledAt  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lastReconciledAt])
}

/// Versioned, server-owned definition lifecycle. Definitions remain in source
/// control; this row records their checksum and active/retired lifecycle.
model GamificationRuleSet {
  id                          String                    @id @default(uuid())
  version                     String                    @unique @db.VarChar(64)
  status                      String                    @default("DRAFT") @db.VarChar(16)
  schemaVersion               Int
  definitionChecksum          String                    @db.Char(64)
  levelDefinitionChecksum     String?                   @db.Char(64)
  challengeDefinitionChecksum String?                   @db.Char(64)
  effectiveFrom               DateTime?
  retiredAt                   DateTime?
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt
  gamificationLevels          UserGamificationLevel[]
  achievementProgresses       UserAchievementProgress[]
  achievementUnlocks          UserAchievement[]
  challengeInstances          ChallengeInstance[]

  @@index([status])
  @@index([status, effectiveFrom])
}

/// Private, recomputable progress for one source-controlled achievement rule.
/// Boolean metric values use the exact integer encoding false=0, true=1.
model UserAchievementProgress {
  id              String   @id @default(uuid())
  userId          String
  achievementId   String   @db.VarChar(128)
  ruleSetVersion  String   @db.VarChar(64)
  metricId        String   @db.VarChar(128)
  valueType       String   @db.VarChar(16)
  currentValue    BigInt   @db.BigInt
  targetValue     BigInt   @db.BigInt
  completed       Boolean  @default(false)
  lastEvaluatedAt DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  ruleSet GamificationRuleSet @relation(fields: [ruleSetVersion], references: [version], onDelete: Restrict)

  @@unique([userId, achievementId, ruleSetVersion], map: "ua_progress_user_achievement_version_key")
  @@index([userId, ruleSetVersion], map: "ua_progress_user_version_idx")
  @@index([metricId, completed], map: "ua_progress_metric_completed_idx")
}

/// Permanent private unlock history. Rule changes and lower current metrics
/// never delete or revoke this record.
model UserAchievement {
  id                          String   @id @default(uuid())
  userId                      String
  achievementId               String   @db.VarChar(128)
  unlockedUnderRuleSetVersion String   @db.VarChar(64)
  metricId                    String   @db.VarChar(128)
  valueType                   String   @db.VarChar(16)
  metricValueAtUnlock         BigInt   @db.BigInt
  targetValueAtUnlock         BigInt   @db.BigInt
  definitionChecksumAtUnlock  String   @db.Char(64)
  unlockedAt                  DateTime @default(now())
  createdAt                   DateTime @default(now())

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  ruleSet GamificationRuleSet @relation(fields: [unlockedUnderRuleSetVersion], references: [version], onDelete: Restrict)

  @@unique([userId, achievementId], map: "ua_unlock_user_achievement_key")
  @@index([userId, unlockedAt], map: "ua_unlock_user_unlocked_idx")
  @@index([achievementId, unlockedAt], map: "ua_unlock_achievement_unlocked_idx")
}

/// Current rebuildable lifetime Level projection; one row per user.
model UserGamificationLevel {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  ruleSetVersion          String   @db.VarChar(64)
  definitionChecksum      String   @db.Char(64)
  levelDefinitionChecksum String   @db.Char(64)
  level                   Int
  lifetimePoints          BigInt   @db.BigInt
  maxLevelReached         Boolean  @default(false)
  lastEvaluatedAt         DateTime @default(now())
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  ruleSet GamificationRuleSet @relation(fields: [ruleSetVersion], references: [version], onDelete: Restrict)

  @@index([ruleSetVersion], map: "ugl_ruleset_version_idx")
  @@map("UserGamificationLevel")
}

/// One immutable, version-frozen weekly Challenge occurrence.
model ChallengeInstance {
  id                    String   @id @default(uuid())
  challengeDefinitionId String   @db.VarChar(128)
  ruleSetVersion        String   @db.VarChar(64)
  logicalPeriodKey      String   @db.VarChar(10)
  metricId              String   @db.VarChar(128)
  targetValue           BigInt   @db.BigInt
  enrollmentPolicy      String   @db.VarChar(16)
  windowPolicy          String   @db.VarChar(16)
  titleKey              String   @db.VarChar(160)
  descriptionKey        String   @db.VarChar(160)
  visibility            String   @db.VarChar(32)
  sortOrder             Int
  startsAt              DateTime
  endsAt                DateTime
  status                String   @default("UPCOMING") @db.VarChar(16)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  ruleSet  GamificationRuleSet     @relation(fields: [ruleSetVersion], references: [version], onDelete: Restrict)
  progress UserChallengeProgress[]

  @@unique([challengeDefinitionId, ruleSetVersion, logicalPeriodKey], map: "cci_definition_version_period_key")
  @@unique([challengeDefinitionId, logicalPeriodKey], map: "cci_definition_period_key")
  @@index([status, startsAt, endsAt], map: "cci_status_period_idx")
  @@map("ChallengeInstance")
}

/// Private canonical progress for one user and one immutable Challenge instance.
model UserChallengeProgress {
  id                  String    @id @default(uuid())
  userId              String
  challengeInstanceId String
  status              String    @default("ACTIVE") @db.VarChar(16)
  metricId            String    @db.VarChar(128)
  baselineValue       BigInt    @default(0) @db.BigInt
  currentValue        BigInt    @default(0) @db.BigInt
  targetValue         BigInt    @db.BigInt
  enrolledAt          DateTime  @default(now())
  lastEvaluatedAt     DateTime  @default(now())
  completedAt         DateTime?
  expiredAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  instance ChallengeInstance @relation(fields: [challengeInstanceId], references: [id], onDelete: Restrict)

  @@unique([userId, challengeInstanceId], map: "ucp_user_instance_key")
  @@index([userId, status, updatedAt], map: "ucp_user_status_updated_idx")
  @@index([challengeInstanceId, status], map: "ucp_instance_status_idx")
  @@map("UserChallengeProgress")
}

/// Canonical server-owned competition window.
model LeaderboardSeason {
  id                         String    @id @default(uuid())
  scope                      String    @db.VarChar(16)
  seasonKey                  String    @db.VarChar(64)
  startsAt                   DateTime?
  endsAt                     DateTime?
  status                     String    @default("UPCOMING") @db.VarChar(16)
  gamificationRuleSetVersion String?   @db.VarChar(64)
  pointsRuleVersionSetHash   String?   @db.Char(64)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  closedAt                   DateTime?

  snapshots LeaderboardSnapshot[]

  @@unique([scope, seasonKey], map: "leaderboard_season_scope_key")
  @@index([status, scope, startsAt, endsAt], map: "leaderboard_season_status_window_idx")
  @@map("LeaderboardSeason")
}

/// Atomic, immutable ranking computation. New FINAL revisions supersede prior
/// finals without changing their historical entries.
model LeaderboardSnapshot {
  id                       String   @id @default(uuid())
  seasonId                 String
  snapshotType             String   @db.VarChar(16)
  status                   String   @default("READY") @db.VarChar(16)
  generatedAt              DateTime
  scoreThrough             DateTime
  sourceFingerprint        String   @db.Char(64)
  entryCount               Int
  rankingSemanticsVersion  String   @db.VarChar(64)
  pointsRuleVersionSetHash String?  @db.Char(64)
  revision                 Int      @default(1)
  supersedesSnapshotId     String?  @unique
  createdAt                DateTime @default(now())

  season       LeaderboardSeason          @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  entries      LeaderboardSnapshotEntry[]
  supersedes   LeaderboardSnapshot?       @relation("LeaderboardSnapshotRevision", fields: [supersedesSnapshotId], references: [id], onDelete: Restrict)
  supersededBy LeaderboardSnapshot?       @relation("LeaderboardSnapshotRevision")

  @@unique([seasonId, snapshotType, revision], map: "leaderboard_snapshot_revision_key")
  @@index([seasonId, snapshotType, revision], map: "leaderboard_snapshot_revision_idx")
  @@index([seasonId, snapshotType, generatedAt], map: "leaderboard_snapshot_generated_idx")
  @@map("LeaderboardSnapshot")
}

/// Ranking data only; public display fields are resolved from the current
/// account state and are never copied into historical snapshots.
model LeaderboardSnapshotEntry {
  id            String   @id @default(uuid())
  snapshotId    String
  userId        String?
  score         BigInt   @db.BigInt
  rank          Int
  tieSize       Int
  levelSnapshot Int?
  createdAt     DateTime @default(now())

  snapshot LeaderboardSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  user     User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([snapshotId, userId], map: "leaderboard_entry_snapshot_user_key")
  @@index([snapshotId, rank, score, userId], map: "leaderboard_entry_page_idx")
  @@map("LeaderboardSnapshotEntry")
}

/// Immutable history of internally issued Recall interactions.
model RecallAttempt {
  id                       String    @id @default(uuid())
  userId                   String
  itemType                 String    @db.VarChar(16)
  itemId                   String
  lectureId                String
  status                   String    @default("PRESENTED") @db.VarChar(16)
  presentedAt              DateTime  @default(now())
  expiresAt                DateTime?
  answeredAt               DateTime?
  skippedAt                DateTime?
  expiredAt                DateTime?
  answerKind               String?   @db.VarChar(32)
  answerValue              String?   @db.VarChar(32)
  outcome                  String?   @db.VarChar(48)
  evidenceClass            String    @default("SERVER_VALIDATED") @db.VarChar(32)
  privacyClass             String    @default("PRIVATE_STUDY") @db.VarChar(32)
  issuanceSource           String?   @db.VarChar(16)
  issuancePolicyVersion    String?   @db.VarChar(64)
  issuanceIdempotencyKey   String    @db.VarChar(200)
  issuanceFingerprint      String    @db.Char(64)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, issuanceIdempotencyKey], map: "recall_attempt_user_issuance_key")
  @@index([userId, status, presentedAt], map: "recall_attempt_user_status_presented_idx")
  @@index([userId, itemType, itemId, presentedAt], map: "recall_attempt_user_item_presented_idx")
  @@index([userId, issuanceSource, issuancePolicyVersion, presentedAt], map: "recall_attempt_user_periodic_presented_idx")
  @@index([itemType, itemId, presentedAt], map: "recall_attempt_item_presented_idx")
  @@map("RecallAttempt")
}

/// Rebuildable per-user/item counters derived only from RecallAttempt history.
model RecallItemState {
  id                          String    @id @default(uuid())
  userId                      String
  itemType                    String    @db.VarChar(16)
  itemId                      String
  lectureId                   String
  presentationCount           Int       @default(0)
  answerCount                 Int       @default(0)
  skipCount                   Int       @default(0)
  objectiveCorrectCount       Int       @default(0)
  objectiveIncorrectCount     Int       @default(0)
  selfReportedHardCount       Int       @default(0)
  selfReportedMediumCount     Int       @default(0)
  selfReportedEasyCount       Int       @default(0)
  lastPresentedAt             DateTime?
  lastAnsweredAt              DateTime?
  lastSkippedAt               DateTime?
  lastOutcome                 String?   @db.VarChar(48)
  revision                    Int       @default(0)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId], map: "recall_item_state_user_item_key")
  @@index([userId, lastPresentedAt], map: "recall_item_state_user_presented_idx")
  @@index([userId, lectureId, lastPresentedAt], map: "recall_item_state_user_lecture_presented_idx")
  @@map("RecallItemState")
}

/// Rebuildable private per-user/per-lecture projection of canonical study evidence.
model LectureMastery {
  id                            String              @id @default(uuid())
  userId                        String
  lectureId                     String
  state                         LectureMasteryState @default(NOT_STARTED)
  evidenceScore                 Int                 @default(0)
  evidenceCount                 Int                 @default(0)
  objectiveAttemptCount         Int                 @default(0)
  objectiveCorrectCount         Int                 @default(0)
  objectiveIncorrectCount       Int                 @default(0)
  flashcardReviewCount          Int                 @default(0)
  flashcardRememberedCount      Int                 @default(0)
  flashcardNotRememberedCount   Int                 @default(0)
  recallObjectiveAttemptCount   Int                 @default(0)
  recallObjectiveCorrectCount   Int                 @default(0)
  recallObjectiveIncorrectCount Int                 @default(0)
  meaningfulFocusSessionCount   Int                 @default(0)
  meaningfulFocusSeconds        Int                 @default(0)
  lastStudyEvidenceAt           DateTime?
  lastObjectiveEvidenceAt       DateTime?
  lastRecallEvidenceAt          DateTime?
  ruleVersion                   String              @default("mastery-v1")
  revision                      Int                 @default(0)
  lastEvaluatedAt               DateTime            @default(now())
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime            @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lecture Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  @@unique([userId, lectureId], map: "lecture_mastery_user_lecture_key")
  @@index([userId, state], map: "lecture_mastery_user_state_idx")
  @@index([userId, lastEvaluatedAt], map: "lecture_mastery_user_evaluated_idx")
  @@index([lectureId, state], map: "lecture_mastery_lecture_state_idx")
}
