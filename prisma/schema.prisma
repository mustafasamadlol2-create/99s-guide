generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                        String                    @id @default(uuid())
  email                     String                    @unique
  profileEmail              String?
  passwordHash              String?
  name                      String?
  avatar                    String?                   @default("")
  avatarUrl                 String?                   @default("")
  signature                 String?                   @default("")
  role                      String                    @default("user")
  isOnline                  Boolean                   @default(false)
  lastActive                DateTime                  @default(now())
  lastSeen                  DateTime                  @default(now())
  socketId                  String?
  deviceToken               String?
  accountStatus             String                    @default("ACTIVE")
  isPrimaryOwner            Boolean                   @default(false)
  emailVerified             Boolean                   @default(true)
  sessionVersion            Int                       @default(0)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  studentGroup              String                    @default("A")
  totalPoints               Int                       @default(0)
  level                     String                    @default("Rising (Resident)")
  levelBadge                String                    @default("👶")
  streakDays                Int                       @default(0)
  totalTimeSpent            Int                       @default(0)
  preferences               Json?                     @default("{\"theme\": \"system\", \"language\": \"en\", \"pushAlerts\": true}")
  calendarEvents            CalendarEvent[]
  flashcardProgresses       FlashcardProgress[]
  lectureProgresses         LectureProgress[]
  pointsLogs                PointsLog[]
  userProgresses            UserProgress[]
  qaQuestions               QaQuestion[]              @relation("QaQuestions")
  qaAnswers                 QaAnswer[]                @relation("QaAnswers")
  blocksMade                UserBlock[]               @relation("BlocksMade")
  blocksReceived            UserBlock[]               @relation("BlocksReceived")
  reportsMade               Report[]                  @relation("ReportsMade")
  reportsReceived           Report[]                  @relation("ReportsReceived")
  mutesReceived             UserMute[]                @relation("MutesReceived")
  bansReceived              UserBan[]                 @relation("BansReceived")
  moderationActionsGiven    ModerationHistory[]       @relation("HistoryByAdmin")
  moderationActionsReceived ModerationHistory[]       @relation("HistoryForTarget")
  passwordResetTokens       PasswordResetToken[]
  emailVerificationTokens   EmailVerificationToken[]
  oauthIdentities           OAuthIdentity[]           @relation
  qaVotes                   QaVote[]
  calendarImportJobs        CalendarImportJob[]
  resourceMultipartUploads  ResourceMultipartUpload[]
  focusPlans                FocusPlan[]
  focusSessions             FocusSession[]
  focusQuickNotes           FocusQuickNote[]
  studyEvents               StudyEvent[]
  studyDailyMetrics         StudyDailyMetric[]
  groupFocusRoomsHosted     GroupFocusRoom[]          @relation("GroupFocusRoomHost")
  groupFocusMemberships     GroupFocusMembership[]

  @@index([role])
  @@index([isOnline, lastActive])
  @@index([studentGroup])
  @@index([name])
  @@index([createdAt])
  @@index([accountStatus])
  @@index([isPrimaryOwner])
}

model Lecture {
  id                       String                    @id @default(uuid())
  name                     String
  mainSubject              String
  subSubject               String?
  trackMode                String
  department               String?
  createdAt                DateTime                  @default(now())
  flashcards               Flashcard[]
  lectureProgresses        LectureProgress[]
  materials                Material[]
  mcqs                     Mcq[]
  resourceMultipartUploads ResourceMultipartUpload[]
  focusPlanItems           FocusPlanItem[]
  focusSessions            FocusSession[]
  focusQuickNotes          FocusQuickNote[]          @relation("FocusQuickNoteLecture")
  studyEvents              StudyEvent[]
  groupFocusRoomsShared    GroupFocusRoom[]          @relation("GroupFocusRoomSharedLecture")
  groupFocusMemberships    GroupFocusMembership[]    @relation("GroupFocusMembershipSelectedLecture")

  @@index([name])
  @@index([mainSubject])
}

model Material {
  id             String         @id @default(uuid())
  title          String
  type           String
  fileUrlOrLink  String
  lectureId      String
  createdAt      DateTime       @default(now())
  fileData       Bytes?
  storagePath    String?
  lecture        Lecture        @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  userProgresses UserProgress[]
  studyEvents    StudyEvent[]

  @@index([lectureId])
  @@index([title])
  @@index([storagePath])
}

model ResourceMultipartUpload {
  id                String   @id @default(uuid())
  userId            String
  lectureId         String
  title             String
  originalFilename  String
  sanitizedFilename String
  mimeType          String
  declaredSizeBytes BigInt
  lastModifiedMs    BigInt?
  storagePath       String   @unique
  multipartUploadId String
  partSizeBytes     Int
  expectedPartCount Int
  status            String   @default("UPLOADING")
  createdAt         DateTime @default(now())
  expiresAt         DateTime
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lecture           Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  @@index([userId, status, expiresAt])
  @@index([lectureId, status])
}

model ModuleResource {
  id                String    @id @default(uuid())
  moduleId          String
  title             String
  storagePath       String    @unique
  fileSizeBytes     BigInt
  status            String    @default("PENDING")
  multipartUploadId String?
  uploadExpiresAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([moduleId, status, createdAt])
  @@index([status, uploadExpiresAt])
}

model Mcq {
  id            String       @id @default(uuid())
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  hint          String?
  explanation   String?
  sourceType    String       @default("ai")
  sourceRef     String       @default("")
  difficulty    String       @default("Medium")
  lectureId     String
  createdAt     DateTime     @default(now())
  lecture       Lecture      @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  studyEvents   StudyEvent[]

  @@index([lectureId])
  @@index([question])
}

model Flashcard {
  id                  String              @id @default(uuid())
  clinicalConcept     String
  explanation         String
  lectureId           String
  createdAt           DateTime            @default(now())
  lecture             Lecture             @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  flashcardProgresses FlashcardProgress[]
  studyEvents         StudyEvent[]

  @@index([lectureId])
  @@index([clinicalConcept])
}

model CalendarEvent {
  id                   String   @id @default(uuid())
  userId               String?
  title                String
  eventType            String
  startDateTime        DateTime
  endDateTime          DateTime
  targetGroups         String   @default("ALL")
  description          String?
  subjectId            String?
  lectureId            String?
  room                 String?
  doctor               String?
  notes                String?
  isPinned             Boolean  @default(false)
  isCompleted          Boolean  @default(false)
  allDay               Boolean  @default(false)
  importSource         String?
  sourceDocumentName   String?
  sourceDocumentSha256 String?
  sourcePage           Int?
  importFingerprint    String?  @unique
  user                 User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([startDateTime])
  @@index([endDateTime])
  @@index([userId])
  @@index([eventType])
  @@index([targetGroups])
  @@index([sourceDocumentSha256])
}

model CalendarImportJob {
  id                  String    @id @default(uuid())
  userId              String
  status              String    @default("UPLOADED")
  stage               String    @default("Uploading")
  sourceFileName      String
  sourceMime          String
  sourceSha256        String
  sourcePageCount     Int?
  sourcePath          String?
  timezone            String    @default("Asia/Baghdad")
  defaultTargetGroups String    @default("ALL")
  progressCurrent     Int       @default(0)
  progressTotal       Int       @default(0)
  previewData         Json?
  errorCode           String?
  errorMessage        String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  completedAt         DateTime?
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([status, updatedAt])
  @@index([sourceSha256])
}

model PointsLog {
  id        String   @id @default(uuid())
  userId    String
  points    Int
  reason    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model SmartNotification {
  id     String   @id @default(uuid())
  title  String
  body   String
  type   String   @default("system")
  sentAt DateTime @default(now())
  read   Boolean  @default(false)

  @@index([read, sentAt])
  @@index([type])
}

model LectureProgress {
  userId              String
  lectureId           String
  pdfCompleted        Boolean  @default(false)
  notesCompleted      Boolean  @default(false)
  videoCompleted      Boolean  @default(false)
  flashcardsCompleted Boolean  @default(false)
  quizCompleted       Boolean  @default(false)
  quizScore           Int?
  lastAccessed        DateTime @default(now())
  lecture             Lecture  @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, lectureId])
  @@index([lectureId])
}

model UserProgress {
  id          String   @id @default(uuid())
  userId      String
  materialId  String
  hasViewed   Boolean  @default(false)
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  material    Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
  @@index([materialId])
}

model Notification {
  id           String   @id @default(uuid())
  title        String
  message      String
  isSystem     Boolean  @default(true)
  targetUserId String?
  targetGroup  String? // null = everyone; "A"/"B"/"C"/"D"/"E" = that group only
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([targetUserId])
  @@index([targetGroup])
}

model FlashcardProgress {
  id          String    @id @default(uuid())
  userId      String
  flashcardId String
  status      String    @default("medium")
  updatedAt   DateTime  @updatedAt
  flashcard   Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, flashcardId])
  @@index([userId])
}

model DailyMotto {
  id         String   @id @default(uuid())
  message    String
  isActive   Boolean  @default(true)
  isFeatured Boolean  @default(false)
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive])
  @@index([createdAt])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime
}

model QaQuestion {
  id        String     @id @default(uuid())
  lectureId String
  userId    String
  content   String
  upvotes   Int        @default(0)
  isDeleted Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation("QaQuestions", fields: [userId], references: [id], onDelete: Cascade)
  answers   QaAnswer[]

  @@index([lectureId])
  @@index([userId])
}

model QaAnswer {
  id         String     @id @default(uuid())
  questionId String
  userId     String
  content    String
  upvotes    Int        @default(0)
  isBest     Boolean    @default(false)
  isDeleted  Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User       @relation("QaAnswers", fields: [userId], references: [id], onDelete: Cascade)
  question   QaQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([userId])
}

model QaVote {
  id         String   @id @default(uuid())
  userId     String
  targetId   String
  targetType String
  value      Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
}

model UserMute {
  id          String    @id @default(uuid())
  userId      String    @unique
  reason      String
  startTime   DateTime  @default(now())
  endTime     DateTime?
  isPermanent Boolean   @default(false)
  createdBy   String
  createdAt   DateTime  @default(now())
  user        User      @relation("MutesReceived", fields: [userId], references: [id], onDelete: Cascade)

  @@index([endTime])
}

model UserBan {
  id          String    @id @default(uuid())
  userId      String    @unique
  reason      String
  startTime   DateTime  @default(now())
  endTime     DateTime?
  isPermanent Boolean   @default(false)
  createdBy   String
  createdAt   DateTime  @default(now())
  user        User      @relation("BansReceived", fields: [userId], references: [id], onDelete: Cascade)

  @@index([endTime])
}

model Report {
  id             String   @id @default(uuid())
  reporterId     String
  reportedUserId String
  lectureId      String?
  commentId      String
  commentType    String
  commentContent String
  reason         String
  description    String?
  status         String   @default("Pending")
  createdAt      DateTime @default(now())
  reporter       User     @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser   User     @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@unique([reporterId, commentId])
  @@index([reporterId])
  @@index([reportedUserId])
  @@index([commentId])
  @@index([status])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model OAuthIdentity {
  id              String   @id @default(uuid())
  userId          String   @unique
  provider        String
  providerSubject String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([provider])
  @@index([providerSubject])
}

model ModerationHistory {
  id             String    @id @default(cuid())
  actionType     String
  adminId        String?
  targetUserId   String?
  commentId      String?
  questionId     String?
  answerId       String?
  replyId        String?
  lectureId      String?
  reportId       String?
  reason         String?
  notes          String?
  oldStatus      String?
  newStatus      String?
  duration       Int?
  isPermanent    Boolean   @default(false)
  isSystemAction Boolean   @default(false)
  createdAt      DateTime  @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?
  revokedBy      String?
  metadata       Json?

  admin      User? @relation("HistoryByAdmin", fields: [adminId], references: [id])
  targetUser User? @relation("HistoryForTarget", fields: [targetUserId], references: [id])

  @@index([adminId])
  @@index([targetUserId])
  @@index([actionType])
  @@index([createdAt])
  @@index([reportId])
  @@index([lectureId])
  @@index([questionId])
  @@index([answerId])
  @@index([isSystemAction])
  @@index([expiresAt])
  @@index([revokedAt])
}

/// Private student-owned Focus Hub plan. Status remains an application-level
/// string until the Focus Service freezes its lifecycle semantics.
model FocusPlan {
  id          String    @id @default(uuid())
  userId      String
  title       String
  status      String    @default("ACTIVE")
  timezone    String
  planVersion Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         FocusPlanItem[]
  focusSessions FocusSession[]

  @@index([userId, status, updatedAt])
}

/// Each Lecture has independent Focus configuration inside a plan.
model FocusPlanItem {
  id                   String   @id @default(uuid())
  planId               String
  lectureId            String
  sequence             Int
  sessionCount         Int
  focusDurationSeconds Int
  breakDurationSeconds Int
  includeMcq           Boolean
  includeFlashcards    Boolean
  includeVideo         Boolean
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  plan                FocusPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  lecture             Lecture         @relation(fields: [lectureId], references: [id], onDelete: Restrict)
  focusSessions       FocusSession[]
  quickNoteConversion FocusQuickNote? @relation("FocusQuickNoteConversion")

  @@unique([planId, sequence])
}

/// Durable solo Focus lifecycle/checkpoint record. Restricting plan/content
/// deletion protects historical sessions; archival is preferred.
model FocusSession {
  id               String    @id @default(uuid())
  userId           String
  planId           String
  planItemId       String
  lectureId        String
  status           String    @default("CREATED")
  startedAt        DateTime?
  plannedEndAt     DateTime?
  actualEndedAt    DateTime?
  lastCheckpointAt DateTime?
  activeSeconds    Int       @default(0)
  pauseSeconds     Int       @default(0)
  completionReason String?
  clientInstanceId String?
  idempotencyKey   String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        FocusPlan        @relation(fields: [planId], references: [id], onDelete: Restrict)
  planItem    FocusPlanItem    @relation(fields: [planItemId], references: [id], onDelete: Restrict)
  lecture     Lecture          @relation(fields: [lectureId], references: [id], onDelete: Restrict)
  quickNotes  FocusQuickNote[] @relation("FocusQuickNoteSession")
  studyEvents StudyEvent[]

  @@unique([userId, idempotencyKey])
  @@index([userId, status, updatedAt])
  @@index([userId, startedAt])
  @@index([planId, planItemId])
}

/// Private, PostgreSQL-only notes attached to a canonical solo Focus Session.
model FocusQuickNote {
  id                    String    @id @default(uuid())
  userId                String
  focusSessionId        String
  lectureId             String
  content               String
  status                String    @default("ACTIVE")
  idempotencyKey        String
  convertedToPlanItemId String?   @unique
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  archivedAt            DateTime?
  convertedAt           DateTime?

  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  focusSession        FocusSession   @relation("FocusQuickNoteSession", fields: [focusSessionId], references: [id], onDelete: Restrict)
  lecture             Lecture        @relation("FocusQuickNoteLecture", fields: [lectureId], references: [id], onDelete: Restrict)
  convertedToPlanItem FocusPlanItem? @relation("FocusQuickNoteConversion", fields: [convertedToPlanItemId], references: [id], onDelete: Restrict)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([focusSessionId, createdAt])
  @@index([lectureId, createdAt])
}

model GroupFocusRoom {
  id                   String    @id @default(uuid())
  hostUserId           String
  name                 String
  visibility           String
  mode                 String
  sharedLectureId      String?
  focusDurationSeconds Int
  breakDurationSeconds Int
  roundCount           Int
  maxParticipants      Int       @default(12)
  status               String    @default("OPEN")
  createIdempotencyKey String
  inviteTokenHash      String?
  inviteVersion        Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  closedAt             DateTime?

  host          User                   @relation("GroupFocusRoomHost", fields: [hostUserId], references: [id], onDelete: Cascade)
  sharedLecture Lecture?               @relation("GroupFocusRoomSharedLecture", fields: [sharedLectureId], references: [id], onDelete: Restrict)
  memberships   GroupFocusMembership[]

  @@unique([hostUserId, createIdempotencyKey])
  @@index([visibility, status, createdAt])
  @@index([hostUserId, status])
  @@index([sharedLectureId])
}

model GroupFocusMembership {
  id                String    @id @default(uuid())
  roomId            String
  userId            String
  role              String
  status            String    @default("ACTIVE")
  selectedLectureId String?
  joinedAt          DateTime  @default(now())
  leftAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  room            GroupFocusRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  selectedLecture Lecture?       @relation("GroupFocusMembershipSelectedLecture", fields: [selectedLectureId], references: [id], onDelete: Restrict)

  @@unique([roomId, userId])
  @@index([roomId, status])
  @@index([userId, status])
  @@index([selectedLectureId])
}

/// Canonical normalized learning-event envelope. Event values remain strings
/// so future valid event types do not require a database enum migration.
model StudyEvent {
  id               String   @id @default(uuid())
  schemaVersion    Int      @default(1)
  eventType        String
  userId           String
  occurredAt       DateTime
  receivedAt       DateTime
  source           String
  idempotencyKey   String
  lectureId        String?
  materialId       String?
  mcqId            String?
  flashcardId      String?
  focusSessionId   String?
  groupFocusRoomId String?
  evidenceClass    String
  privacyClass     String
  payload          Json
  createdAt        DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lecture      Lecture?      @relation(fields: [lectureId], references: [id], onDelete: SetNull)
  material     Material?     @relation(fields: [materialId], references: [id], onDelete: SetNull)
  mcq          Mcq?          @relation(fields: [mcqId], references: [id], onDelete: SetNull)
  flashcard    Flashcard?    @relation(fields: [flashcardId], references: [id], onDelete: SetNull)
  focusSession FocusSession? @relation(fields: [focusSessionId], references: [id], onDelete: SetNull)

  @@unique([userId, idempotencyKey])
  @@index([userId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([lectureId, occurredAt])
  @@index([focusSessionId, occurredAt])
}

/// Server-derived private daily counters. metricDate is a PostgreSQL DATE
/// representing the logical academic day, calculated by the service.
model StudyDailyMetric {
  id                 String   @id @default(uuid())
  userId             String
  metricDate         DateTime @db.Date
  focusSeconds       Int      @default(0)
  sessionsCompleted  Int      @default(0)
  mcqAttempts        Int      @default(0)
  mcqCorrect         Int      @default(0)
  flashcardReviews   Int      @default(0)
  recallAttempts     Int      @default(0)
  recallCorrect      Int      @default(0)
  lectureCompletions Int      @default(0)
  interruptionCount  Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, metricDate])
}

/// Infrastructure-only queue for canonical-to-private-D1 projection delivery.
/// The enqueue path assigns revision from the same generated BIGINT as id.
model PrivateD1SyncOutbox {
  id            BigInt   @id @default(autoincrement())
  entity        String   @db.VarChar(100)
  operation     String   @db.VarChar(16)
  key           Json
  revision      BigInt
  data          Json?
  attempts      Int      @default(0)
  lastError     String?  @db.VarChar(500)
  nextAttemptAt DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([nextAttemptAt, id])
}
